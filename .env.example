# ============================================================
# Django Core
# ============================================================
# برای ساخت SECRET_KEY قوی:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-please-generate-a-random-50-char-string
DJANGO_DEBUG=True

# ============================================================
# Hosts & CSRF
# ============================================================
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ============================================================
# Feature Flags
# ============================================================
# True = کاربر خودکار مهمان، UI لاگین مخفی
# False = صفحه لاگین/ثبت‌نام نمایش داده می‌شود
DJANGO_FORCE_GUEST_MODE=False

# ============================================================
# Database (اختیاری)
# ============================================================
# اگه خالی باشه، SQLite استفاده می‌شه
# DJANGO_DATABASE_URL=postgres://user:pass@host:5432/dbname

# ============================================================
# Redis (اختیاری)
# ============================================================
# DJANGO_REDIS_URL=redis://localhost:6379/0

# ============================================================
# Email
# ============================================================
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# برای prod:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_HOST_USER=your-email@gmail.com
# DJANGO_EMAIL_HOST_PASSWORD=your-app-password-here
# DJANGO_DEFAULT_FROM_EMAIL=noreply@esmfamil.com

# ============================================================
# URLs
# ============================================================
DJANGO_BACKEND_URL=http://127.0.0.1:8000

# ============================================================
# CORS (فقط وقتی DEBUG=False)
# ============================================================
# DJANGO_CORS_ALLOWED_ORIGINS=https://esmfamil.com
