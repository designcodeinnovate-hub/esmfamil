{% extends "base.html" %}
{% block title %}اتحاد{% endblock %}

{% block extra_css %}
<style>
  .page-head { margin-bottom: 20px; }
  .page-head h1 { font-size: 22px; font-weight: bold; }
  .page-head h1 span { color: var(--gold); }
  p.sub { color: var(--muted); font-size: 13px; margin-bottom: 20px; line-height: 1.6; }

  .action-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 24px; }
  .action-card {
    background: rgba(30, 41, 59, 0.6);
    backdrop-filter: blur(10px);
    border: 1.5px solid rgba(148,163,184,0.15);
    border-radius: 20px; padding: 24px 20px;
    display: flex; flex-direction: column; align-items: center; text-align: center;
    text-decoration: none; color: #fff; transition: 0.25s; cursor: pointer;
    position: relative; overflow: hidden;
  }
  .action-card::before {
    content: ""; position: absolute; inset: 0; opacity: 0;
    background: radial-gradient(circle at top right, rgba(255,255,255,0.1), transparent);
    transition: 0.3s;
  }
  .action-card:hover { transform: translateY(-4px); }
  .action-card:hover::before { opacity: 1; }
  
  .action-create { border-color: rgba(34,197,94,0.4); }
  .action-create:hover { box-shadow: 0 10px 30px rgba(34,197,94,0.2); border-color: #22c55e; }
  .action-join { border-color: rgba(6,182,212,0.4); }
  .action-join:hover { box-shadow: 0 10px 30px rgba(6,182,212,0.2); border-color: #06b6d4; }
  
  .action-icon { font-size: 40px; margin-bottom: 12px; }
  .action-title { font-size: 16px; font-weight: bold; margin-bottom: 6px; }
  .action-desc { font-size: 11.5px; color: var(--muted); }

  .box {
    background: rgba(30, 41, 59, 0.6); border: 1px solid var(--border);
    border-radius: 20px; padding: 20px;
  }
  .box h3 { font-size: 15px; color: var(--gold); margin-bottom: 16px; }

  .alliance-item {
    display: flex; align-items: center; gap: 14px;
    padding: 14px; border-radius: 14px; margin-bottom: 8px;
    background: rgba(15,23,42,0.5); border: 1px solid transparent;
    transition: 0.2s; text-decoration: none; color: #fff;
  }
  .alliance-item:hover { border-color: var(--gold); background: rgba(15,23,42,0.8); }
  
  .alliance-emblem {
    font-size: 28px; width: 50px; height: 50px;
    background: linear-gradient(135deg, rgba(244,197,66,0.2), rgba(139,92,246,0.2));
    border-radius: 14px; display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; border: 1px solid rgba(255,255,255,0.1);
  }
  .alliance-info { flex: 1; }
  .alliance-name { font-size: 15px; font-weight: bold; margin-bottom: 3px; }
  .alliance-meta { font-size: 12px; color: var(--muted); }
  
  .empty-state { text-align: center; padding: 30px 20px; color: var(--muted); font-size: 13px; }
  .empty-state .icon { font-size: 40px; display: block; margin-bottom: 8px; opacity: 0.4; }
</style>
{% endblock %}

{% block content %}
  <div class="page-head">
    <h1>🛡️ <span>اتحاد</span></h1>
  </div>
  <p class="sub">با دوستات یک تیم بساز، با هم بازی کن و رتبه بگیر!</p>

  <div class="action-grid">
    <a href="/alliance/create/" class="action-card action-create">
      <div class="action-icon">🏰</div>
      <div class="action-title">ساخت اتحاد</div>
      <div class="action-desc">یک تیم جدید بساز</div>
    </a>
    <a href="/social/" class="action-card action-join">
      <div class="action-icon">👥</div>
      <div class="action-title">پیوستن به اتحاد</div>
      <div class="action-desc">از صفحه دوستان اقدام کن</div>
    </a>
  </div>

  <div class="box">
    <h3>🌍 اتحادهای فعال</h3>
    {% if alliances %}
      {% for a in alliances %}
        <div class="alliance-item">
          <div class="alliance-emblem">{{ a.obj.emblem }}</div>
          <div class="alliance-info">
            <div class="alliance-name">{{ a.obj.name }} {% if a.obj.tag %}<span style="font-size:11px;color:var(--gold);">{{ a.obj.tag }}</span>{% endif %}</div>
            <div class="alliance-meta">{{ a.count }} عضو — رهبر: {{ a.leader_avatar }} {{ a.obj.leader.alias }}</div>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <div class="empty-state">
        <span class="icon">🏰</span>
        هنوز هیچ اتحادی ساخته نشده. اولین نفر باش!
      </div>
    {% endif %}
  </div>
{% endblock %}
