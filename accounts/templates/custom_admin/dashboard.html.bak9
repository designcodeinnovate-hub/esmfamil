<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>داشبورد ادمین</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: Tahoma, sans-serif;
      min-height: 100vh;
      background: #0a0a15;
      color: #e2e8f0;
      padding: 20px 16px 40px;
    }
    .container { max-width: 1300px; margin: 0 auto; }

    .topbar {
      display: flex; justify-content: space-between; align-items: center;
      background: linear-gradient(135deg, #1e1b4b, #0f0f1e);
      border: 1px solid rgba(239, 68, 68, 0.3);
      padding: 16px 22px;
      border-radius: 16px;
      margin-bottom: 20px;
    }
    .topbar h1 { font-size: 20px; color: #fca5a5; }
    .topbar .actions { display: flex; gap: 10px; }
    .topbar a, .topbar button {
      padding: 9px 16px;
      border-radius: 10px;
      font-size: 13px;
      font-family: inherit;
      text-decoration: none;
      cursor: pointer;
      border: none;
      font-weight: bold;
    }
    .btn-danger { background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; }
    .btn-ghost { background: rgba(51, 65, 85, 0.6); color: #cbd5e1;
                 border: 1px solid rgba(148, 163, 184, 0.2); }

    /* آمار */
    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 20px;
    }
    @media (max-width: 600px) { .stats { grid-template-columns: 1fr; } }
    .stat {
      background: linear-gradient(135deg, #1a1a2e, #0f0f1e);
      border: 1px solid rgba(148, 163, 184, 0.15);
      padding: 18px 20px;
      border-radius: 14px;
    }
    .stat .label { font-size: 12px; color: #94a3b8; margin-bottom: 6px; }
    .stat .value { font-size: 26px; font-weight: bold; color: #facc15; font-family: monospace; }

    /* جستجو */
    .search-row {
      display: flex; gap: 10px;
      margin-bottom: 16px;
    }
    .search-row input {
      flex: 1;
      padding: 13px 18px;
      border-radius: 12px;
      border: 1px solid rgba(148, 163, 184, 0.2);
      background: #1a1a2e;
      color: #fff;
      font-size: 15px;
      font-family: inherit;
    }
    .search-row input:focus { outline: none; border-color: #facc15; }
    .search-row button {
      padding: 13px 22px;
      border-radius: 12px;
      border: none;
      background: linear-gradient(135deg, #facc15, #eab308);
      color: #1a1a1a;
      font-weight: bold;
      font-size: 14px;
      font-family: inherit;
      cursor: pointer;
    }

    /* جدول */
    .table-wrap {
      background: #12121f;
      border: 1px solid rgba(148, 163, 184, 0.12);
      border-radius: 16px;
      overflow: auto;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 1000px;
    }
    th {
      background: rgba(30, 41, 59, 0.7);
      padding: 14px 12px;
      text-align: right;
      font-size: 12px;
      color: #94a3b8;
      font-weight: bold;
      white-space: nowrap;
      border-bottom: 1px solid rgba(148, 163, 184, 0.15);
      position: sticky; top: 0; z-index: 2;
    }
    td {
      padding: 12px;
      text-align: right;
      font-size: 13px;
      border-bottom: 1px solid rgba(148, 163, 184, 0.08);
      white-space: nowrap;
    }
    tr:hover td { background: rgba(244, 197, 66, 0.04); }

    .username { font-family: monospace; font-weight: bold; color: #facc15; }
    .pid { font-family: monospace; color: #94a3b8; font-size: 12px; }
    .level-badge {
      background: linear-gradient(135deg, #8b5cf6, #6b4eff);
      color: #fff;
      padding: 3px 10px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: bold;
      font-family: monospace;
    }
    .status {
      padding: 3px 10px;
      border-radius: 8px;
      font-size: 11px;
      font-weight: bold;
    }
    .status.on { background: rgba(34, 197, 94, 0.15); color: #4ade80; }
    .status.off { background: rgba(239, 68, 68, 0.15); color: #f87171; }
    .status.staff { background: rgba(244, 197, 66, 0.15); color: #facc15; }

    .avatar-mini {
      font-size: 20px;
      width: 34px; height: 34px;
      display: inline-flex; align-items: center; justify-content: center;
      background: rgba(51, 65, 85, 0.5);
      border-radius: 50%;
    }

    .actions-cell { display: flex; gap: 6px; }
    .actions-cell a, .actions-cell button {
      padding: 6px 10px;
      font-size: 11px;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      text-decoration: none;
      font-family: inherit;
      font-weight: bold;
    }
    .btn-view { background: rgba(6, 182, 212, 0.2); color: #67e8f9; }
    .btn-toggle { background: rgba(234, 179, 8, 0.2); color: #fde68a; }
    .btn-del { background: rgba(239, 68, 68, 0.2); color: #fca5a5; }

    .pass-algo {
      font-family: monospace;
      font-size: 10px;
      color: #64748b;
      background: rgba(51,65,85,0.4);
      padding: 2px 6px;
      border-radius: 6px;
    }
  </style>
</head>
<body>
<div class="container">

  <div class="topbar">
    <h1>🔒 پنل مدیریت کاربران</h1>
    <div class="actions">
      <a href="{% url 'custom_admin:logout' %}" class="btn-danger">خروج</a>
    </div>
  </div>

  <div class="stats">
    <div class="stat">
      <div class="label">👥 کل کاربران</div>
      <div class="value">{{ stats.total_users }}</div>
    </div>
    <div class="stat">
      <div class="label">🎮 کل بازی‌ها</div>
      <div class="value">{{ stats.total_games }}</div>
    </div>
    <div class="stat">
      <div class="label">⭐ مجموع امتیازات</div>
      <div class="value">{{ stats.total_scores }}</div>
    </div>
  </div>

  <form method="get" class="search-row">
    <input type="text" name="q" value="{{ search }}"
           placeholder="جستجو با نام کاربری، نام نمایشی یا شناسه...">
    <button type="submit">🔍 جستجو</button>
  </form>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>آواتار</th>
          <th>نام کاربری</th>
          <th>نام نمایشی</th>
          <th>شناسه</th>
          <th>لول</th>
          <th>امتیاز</th>
          <th>بازی</th>
          <th>موبایل</th>
          <th>وضعیت</th>
          <th>رمز</th>
          <th>عضویت</th>
          <th>آخرین ورود</th>
          <th>عملیات</th>
        </tr>
      </thead>
      <tbody>
        {% for u in users %}
          <tr>
            <td style="color:#64748b">{{ forloop.counter }}</td>
            <td><span class="avatar-mini">{{ u.avatar|default:"❓" }}</span></td>
            <td><span class="username">{{ u.username }}</span></td>
            <td>{{ u.alias }}</td>
            <td><span class="pid">#{{ u.public_id }}</span></td>
            <td><span class="level-badge">Lv {{ u.level }}</span></td>
            <td style="color:#facc15;font-weight:bold;font-family:monospace">{{ u.total_score }}</td>
            <td>{{ u.games }}</td>
            <td style="font-family:monospace;font-size:12px">{{ u.phone }}</td>
            <td>
              {% if not u.is_active %}
                <span class="status off">غیرفعال</span>
              {% elif u.is_staff %}
                <span class="status staff">ادمین</span>
              {% else %}
                <span class="status on">فعال</span>
              {% endif %}
            </td>
            <td>
              <span class="pass-algo">🔐 hash</span>
            </td>
            <td style="font-size:11px;color:#94a3b8">{{ u.date_joined|date:"Y/m/d H:i" }}</td>
            <td style="font-size:11px;color:#94a3b8">
              {% if u.last_login %}{{ u.last_login|date:"Y/m/d H:i" }}{% else %}—{% endif %}
            </td>
            <td>
              <div class="actions-cell">
                <a href="{% url 'custom_admin:user_detail' u.id %}" class="btn-view">مشاهده</a>
                <form method="post" action="{% url 'custom_admin:user_toggle' u.id %}" style="display:inline">
                  {% csrf_token %}
                  <button type="submit" class="btn-toggle">
                    {% if u.is_active %}غیرفعال{% else %}فعال{% endif %}
                  </button>
                </form>
                <form method="post" action="{% url 'custom_admin:user_delete' u.id %}" style="display:inline"
                      onsubmit="return confirm('حذف {{ u.username }}؟');">
                  {% csrf_token %}
                  <button type="submit" class="btn-del">حذف</button>
                </form>
              </div>
            </td>
          </tr>
        {% empty %}
          <tr>
            <td colspan="14" style="text-align:center;color:#64748b;padding:40px">
              هیچ کاربری پیدا نشد.
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

</div>
</body>
</html>
