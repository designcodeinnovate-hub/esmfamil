<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>جزئیات کاربر</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: Tahoma, sans-serif;
      min-height: 100vh;
      background: #0a0a15;
      color: #e2e8f0;
      padding: 20px 16px 40px;
    }
    .container { max-width: 900px; margin: 0 auto; }
    a.back { color: #60a5fa; text-decoration: none; font-size: 14px; }
    h1 { font-size: 22px; color: #facc15; margin: 14px 0 20px; }

    .msg {
      padding: 12px 16px; border-radius: 10px;
      font-size: 13.5px; margin-bottom: 16px; text-align: right;
    }
    .msg-ok { background: rgba(34, 197, 94, 0.15); color: #4ade80;
              border: 1px solid rgba(34, 197, 94, 0.3); }
    .msg-err { background: rgba(239, 68, 68, 0.15); color: #fca5a5;
               border: 1px solid rgba(239, 68, 68, 0.35); }

    .card {
      background: #12121f;
      border: 1px solid rgba(148, 163, 184, 0.15);
      border-radius: 16px;
      padding: 22px;
      margin-bottom: 16px;
    }
    .card h3 { color: #fdba74; font-size: 15px; margin-bottom: 16px; }
    .row {
      display: flex; justify-content: space-between;
      padding: 10px 0;
      border-bottom: 1px solid rgba(148, 163, 184, 0.08);
      font-size: 14px;
    }
    .row:last-child { border-bottom: none; }
    .row .k { color: #94a3b8; }
    .row .v { color: #fff; font-family: monospace; }

    .algo-tag {
      display: inline-block;
      background: rgba(139, 92, 246, 0.2);
      color: #c4b5fd;
      padding: 3px 10px;
      border-radius: 6px;
      font-size: 11px;
      font-family: monospace;
    }

    input[type=text], input[type=password] {
      width: 100%; padding: 12px 14px; border-radius: 10px;
      border: 1.5px solid rgba(148, 163, 184, 0.2);
      background: #0a0a15;
      color: #fff; font-size: 15px;
      font-family: inherit; margin-bottom: 12px;
    }
    input:focus { outline: none; border-color: #facc15; }

    button.action {
      padding: 12px 24px;
      border-radius: 10px;
      border: none;
      font-size: 14px;
      font-weight: bold;
      font-family: inherit;
      cursor: pointer;
    }
    .btn-warning { background: linear-gradient(135deg, #eab308, #f59e0b); color: #1a1a1a; }
    .btn-danger  { background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; }

    table { width: 100%; border-collapse: collapse; }
    th, td { padding: 10px 12px; text-align: right; font-size: 13px;
             border-bottom: 1px solid rgba(148, 163, 184, 0.08); }
    th { color: #94a3b8; font-size: 12px; }

    .info-note {
      background: rgba(59, 130, 246, 0.1);
      border-right: 3px solid #3b82f6;
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 12px;
      color: #93c5fd;
      line-height: 1.7;
      margin-bottom: 14px;
    }

    .avatar-display {
      font-size: 60px;
      width: 90px; height: 90px;
      border-radius: 50%;
      background: #1a1a2e;
      border: 2px solid #facc15;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 16px;
      background-size: cover;
      background-position: center;
      overflow: hidden;
    }
  </style>
</head>
<body>
<div class="container">
  <a class="back" href="{% url 'custom_admin:dashboard' %}">← بازگشت به داشبورد</a>
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
    <h1 style="margin: 14px 0 0;">👤 جزئیات کاربر: {{ u.username }}</h1>
    <a href="{% url 'custom_admin:user_edit' u.id %}" style="margin-top: 14px; padding: 10px 18px; border-radius: 10px; background: linear-gradient(135deg, #8b5cf6, #6b4eff); color: #fff; text-decoration: none; font-size: 13px; font-weight: bold;">✏️ ویرایش کامل</a>
  </div>

  {% if message %}
    <div class="msg {% if message.type == 'success' %}msg-ok{% else %}msg-err{% endif %}">
      {{ message.text }}
    </div>
  {% endif %}

  <div class="card" style="text-align:center">
    {% if u.avatar_type == "image" and u.avatar_id %}
      <div class="avatar-display" style="background-image: url('/static/avatars/images/{{ u.avatar_id|stringformat:"03d" }}.jpg');"></div>
    {% else %}
      <div class="avatar-display">
        {% if u.avatar_id %}
          {{ u.avatar_id }}
        {% else %}
          👤
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div class="card">
    <h3>📋 اطلاعات پایه</h3>
    <div class="row"><span class="k">نام کاربری</span><span class="v">{{ u.username }}</span></div>
    <div class="row"><span class="k">نام نمایشی</span><span class="v">{{ u.alias }}</span></div>
    <div class="row"><span class="k">شناسه عمومی</span><span class="v">#{{ u.public_id }}</span></div>
    <div class="row"><span class="k">موبایل</span><span class="v">{{ u.phone|default:"—" }}</span></div>
    <div class="row"><span class="k">آواتار</span><span class="v">{{ u.avatar_id|default:"—" }} ({{ u.avatar_type }})</span></div>
    <div class="row"><span class="k">وضعیت فعال</span><span class="v">{% if u.is_active %}✓ فعال{% else %}✗ غیرفعال{% endif %}</span></div>
    <div class="row"><span class="k">ادمین</span><span class="v">{{ u.is_staff }}</span></div>
    <div class="row"><span class="k">مهمان</span><span class="v">{{ u.is_guest }}</span></div>
    <div class="row"><span class="k">عضویت</span><span class="v">{{ u.date_joined|date:"Y/m/d H:i" }}</span></div>
    <div class="row"><span class="k">آخرین ورود</span><span class="v">{% if u.last_login %}{{ u.last_login|date:"Y/m/d H:i" }}{% else %}—{% endif %}</span></div>
    <div class="row">
      <span class="k">الگوریتم پسورد</span>
      <span class="v">
        <span class="algo-tag">{{ u.password|slice:":20" }}…</span>
      </span>
    </div>
  </div>

  <!-- تغییر نام نمایشی -->
  <div class="card">
    <h3>✏️ تغییر نام نمایشی</h3>
    <form method="post" action="{% url 'custom_admin:user_change_alias' u.id %}">
      {% csrf_token %}
      <input type="text" name="new_alias" value="{{ u.alias }}" maxlength="32" required>
      <button type="submit" class="action btn-warning">💾 ذخیره نام نمایشی</button>
    </form>
  </div>

  <!-- تغییر پسورد -->
  <div class="card">
    <h3>🔐 تغییر پسورد کاربر</h3>
    <div class="info-note">
      ⚠️ <b>توجه:</b> پسورد فعلی قابل مشاهده نیست (به‌صورت هش در دیتابیس ذخیره شده).
      ولی می‌تونی یک پسورد <b>جدید</b> برای کاربر تعیین کنی.
    </div>
    <form method="post" action="{% url 'custom_admin:user_reset_password' u.id %}"
          onsubmit="return confirm('پسورد کاربر {{ u.username }} تغییر کند؟');">
      {% csrf_token %}
      <input type="password" name="new_password" placeholder="پسورد جدید (حداقل ۶ کاراکتر)" minlength="6" required>
      <button type="submit" class="action btn-danger">🔑 تغییر پسورد</button>
    </form>
  </div>

  <div class="card">
    <h3>🎮 ۲۰ بازی آخر</h3>
    <table>
      <thead>
        <tr>
          <th>تاریخ</th>
          <th>حالت</th>
          <th>وضعیت</th>
          <th>امتیاز</th>
        </tr>
      </thead>
      <tbody>
        {% for g in games %}
          <tr>
            <td>{{ g.created_at|date:"Y/m/d H:i" }}</td>
            <td>{{ g.mode }}</td>
            <td>{{ g.status }}</td>
            <td style="color:#facc15;font-weight:bold">{{ g.score }}</td>
          </tr>
        {% empty %}
          <tr><td colspan="4" style="text-align:center;color:#64748b;padding:20px">بازی‌ای ثبت نشده.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
</body>
</html>
