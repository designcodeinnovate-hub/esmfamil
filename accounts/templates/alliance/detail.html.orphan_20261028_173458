{% extends "base.html" %}
{% block title %}{{ alliance.name }}{% endblock %}
{% block extra_css %}
<style>
  .chat-header {
    position: sticky; top: 0; z-index: 50;
    background: linear-gradient(135deg, rgba(26,15,46,0.98), rgba(15,15,30,0.98));
    backdrop-filter: blur(20px);
    border-bottom: 1.5px solid rgba(139,92,246,0.4);
    padding: 10px 12px;
    display: flex; align-items: center; gap: 10px;
    margin: -16px -16px 0;
    box-shadow: 0 4px 20px rgba(0,0,0,0.4);
  }
  .hdr-btn {
    width: 40px; height: 40px; border-radius: 12px;
    background: rgba(148,163,184,0.12);
    border: 1px solid rgba(148,163,184,0.2);
    display: flex; align-items: center; justify-content: center;
    color: #fff; text-decoration: none; font-size: 18px;
    flex-shrink: 0; transition: 0.2s; cursor: pointer;
    font-family: inherit;
  }
  .hdr-btn:hover { background: rgba(139,92,246,0.3); border-color: rgba(139,92,246,0.5); }
  .hdr-emblem {
    width: 42px; height: 42px; border-radius: 14px;
    background: linear-gradient(135deg, rgba(139,92,246,0.35), rgba(6,182,212,0.2));
    border: 1.5px solid rgba(139,92,246,0.5);
    display: flex; align-items: center; justify-content: center;
    font-size: 22px; flex-shrink: 0;
    box-shadow: 0 0 18px rgba(139,92,246,0.5);
  }
  .hdr-center { flex: 1; min-width: 0; cursor: pointer; }
  .hdr-name {
    font-size: 15px; font-weight: 900; color: #fff;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    margin-bottom: 2px;
    display: flex; align-items: center; gap: 6px;
  }
  .hdr-meta {
    font-size: 11px; color: #94a3b8;
    display: flex; gap: 6px; align-items: center;
  }
  .hdr-menu-wrap { position: relative; flex-shrink: 0; }
  .hdr-menu {
    display: none; position: absolute;
    top: 48px; left: 0;
    background: linear-gradient(135deg, #1a0f2e, #0f0f1e);
    border: 1.5px solid rgba(139,92,246,0.4);
    border-radius: 16px;
    min-width: 220px;
    padding: 8px;
    box-shadow: 0 15px 50px rgba(0,0,0,0.7), 0 0 30px rgba(139,92,246,0.2);
    z-index: 100;
  }
  .hdr-menu.active { display: block; animation: menuIn 0.2s ease-out; }
  @keyframes menuIn { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }
  .hdr-menu-item {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 14px; border-radius: 10px;
    color: #fff; text-decoration: none;
    font-size: 14px; font-weight: bold;
    transition: 0.15s; cursor: pointer;
    border: none; background: transparent;
    font-family: inherit; text-align: right; width: 100%;
  }
  .hdr-menu-item:hover { background: rgba(139,92,246,0.15); }
  .hdr-menu-item .mi-icon { font-size: 18px; width: 24px; text-align: center; }
  .hdr-menu-item.danger { color: #fca5a5; }
  .hdr-menu-item.danger:hover { background: rgba(239,68,68,0.15); }
  .hdr-menu-sep { height: 1px; background: rgba(148,163,184,0.15); margin: 6px 0; }
  .members-strip {
    background: rgba(15,23,42,0.7);
    border-bottom: 1px solid rgba(148,163,184,0.12);
    padding: 10px 12px;
    overflow-x: auto; display: flex; gap: 12px;
    margin: 0 -16px 0;
    scrollbar-width: thin;
  }
  .members-strip::-webkit-scrollbar { height: 3px; }
  .members-strip::-webkit-scrollbar-thumb { background: rgba(139,92,246,0.4); border-radius: 3px; }
  .member-item {
    display: flex; flex-direction: column; align-items: center;
    gap: 4px; cursor: pointer; flex-shrink: 0; width: 58px;
    background: transparent; border: none; padding: 0; font-family: inherit;
    transition: transform 0.2s;
  }
  .member-item:hover { transform: translateY(-2px); }
  .member-av {
    width: 48px; height: 48px; border-radius: 50%;
    background: linear-gradient(135deg, #2a2a4a, #1a1a2e);
    border: 2px solid rgba(148,163,184,0.3);
    display: flex; align-items: center; justify-content: center;
    font-size: 24px; position: relative;
    background-size: cover; background-position: center;
    overflow: hidden;
  }
  .member-av.leader { border-color: #f4c542; box-shadow: 0 0 15px rgba(244,197,66,0.7); }
  .member-av.admin { border-color: #8b5cf6; box-shadow: 0 0 12px rgba(139,92,246,0.6); }
  .member-av.me { border-color: #22c55e; box-shadow: 0 0 12px rgba(34,197,94,0.6); }
  .member-status {
    position: absolute; bottom: 0; right: 0;
    width: 13px; height: 13px; border-radius: 50%;
    border: 2px solid #0f0f1e;
  }
  .member-status.online { background: #22c55e; box-shadow: 0 0 6px #22c55e; }
  .member-status.offline { background: #64748b; }
  .member-name {
    font-size: 9.5px; color: #cbd5e1; text-align: center;
    max-width: 58px; overflow: hidden; text-overflow: ellipsis;
    white-space: nowrap; font-weight: bold;
  }
  .messages-area {
    height: calc(100vh - 340px);
    min-height: 260px;
    overflow-y: auto;
    padding: 14px 4px 16px;
    display: flex; flex-direction: column; gap: 8px;
    scroll-behavior: smooth;
  }
  .messages-area::-webkit-scrollbar { width: 5px; }
  .messages-area::-webkit-scrollbar-thumb { background: rgba(139,92,246,0.3); border-radius: 5px; }
  .msg-row { display: flex; gap: 8px; align-items: flex-end; animation: msgFade 0.3s ease-out; }
  @keyframes msgFade { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
  .msg-row.me { flex-direction: row-reverse; }
  .msg-avatar {
    width: 32px; height: 32px; border-radius: 50%;
    background: linear-gradient(135deg, #2a2a4a, #1a1a2e);
    border: 1.5px solid rgba(148,163,184,0.2);
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; flex-shrink: 0;
    background-size: cover; background-position: center;
    overflow: hidden;
  }
  .msg-content { max-width: 78%; display: flex; flex-direction: column; gap: 3px; }
  .msg-row.me .msg-content { align-items: flex-end; }
  .msg-sender { font-size: 10.5px; color: #c4b5fd; font-weight: bold; margin-bottom: 1px; padding: 0 4px; }
  .msg-bubble {
    padding: 10px 14px; border-radius: 16px;
    background: rgba(30,41,59,0.85);
    border: 1px solid rgba(148,163,184,0.15);
    color: #fff; font-size: 14px; line-height: 1.6;
    border-bottom-left-radius: 4px;
    word-wrap: break-word; word-break: break-word;
  }
  .msg-row.me .msg-bubble {
    background: linear-gradient(135deg, #8b5cf6, #6b4eff);
    border-color: transparent;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 4px;
    box-shadow: 0 4px 15px rgba(139,92,246,0.35);
  }
  .msg-time { font-size: 9px; color: #64748b; margin-top: 2px; padding: 0 4px; font-family: monospace; }
  .system-msg {
    text-align: center; font-size: 11.5px; color: #94a3b8;
    padding: 6px 14px; background: rgba(148,163,184,0.08);
    border-radius: 12px; margin: 6px auto; max-width: 90%;
  }
  .empty-chat {
    text-align: center; color: #64748b; font-size: 13px;
    padding: 50px 20px; margin: auto; line-height: 1.9;
  }
  .empty-chat .big-icon { font-size: 56px; display: block; margin-bottom: 12px; opacity: 0.4; }
  .chat-input-bar {
    display: flex; gap: 8px;
    padding: 10px 4px;
    margin: 0 -16px;
    padding-left: 16px; padding-right: 16px;
    background: linear-gradient(180deg, transparent, #0a0a15 30%);
    position: sticky; bottom: 64px;
    z-index: 40;
  }
  .chat-input-bar input {
    flex: 1; padding: 14px 18px; border-radius: 24px;
    border: 1.5px solid rgba(139,92,246,0.35);
    background: rgba(15,23,42,0.9);
    color: #fff; font-size: 14.5px; font-family: inherit;
    transition: 0.2s;
  }
  .chat-input-bar input:focus {
    outline: none; border-color: #8b5cf6;
    box-shadow: 0 0 18px rgba(139,92,246,0.25);
  }
  .chat-input-bar button {
    width: 50px; height: 50px; border-radius: 50%;
    border: none;
    background: linear-gradient(135deg, #8b5cf6, #6b4eff);
    color: #fff; font-size: 22px; cursor: pointer;
    box-shadow: 0 4px 18px rgba(139,92,246,0.5);
    flex-shrink: 0; transition: 0.2s; font-family: inherit;
    font-weight: 900;
  }
  .chat-input-bar button:hover { transform: scale(1.06); }
  .blocked-bar {
    padding: 14px 16px; text-align: center;
    background: rgba(234,179,8,0.08);
    border: 1.5px solid rgba(234,179,8,0.3);
    border-radius: 14px;
    color: #fde68a; font-size: 13px; line-height: 1.6;
    margin: 0 -16px;
  }
  .member-modal-bg, .info-modal-bg {
    display: none; position: fixed; inset: 0;
    background: rgba(0,0,0,0.88); backdrop-filter: blur(10px);
    z-index: 2000;
    align-items: center; justify-content: center;
    padding: 20px;
  }
  .member-modal-bg.active, .info-modal-bg.active { display: flex; }
  .member-modal, .info-modal {
    background: radial-gradient(circle at 50% 0%, rgba(139,92,246,0.3), transparent 60%),
                linear-gradient(135deg, #1a0f2e, #0f0f1e);
    border: 1.5px solid rgba(139,92,246,0.5);
    border-radius: 24px;
    padding: 28px 22px 22px;
    max-width: 360px; width: 100%;
    max-height: 85vh; overflow-y: auto;
    position: relative;
    box-shadow: 0 30px 70px rgba(0,0,0,0.8), 0 0 50px rgba(139,92,246,0.25);
    text-align: center;
  }
  .member-modal-close {
    position: absolute; top: 14px; left: 14px;
    width: 32px; height: 32px; border-radius: 50%;
    background: rgba(148,163,184,0.12);
    border: 1px solid rgba(148,163,184,0.2);
    color: #fff; cursor: pointer; font-size: 13px;
    font-family: inherit; transition: 0.2s;
  }
  .member-modal-close:hover { background: rgba(239,68,68,0.3); border-color: rgba(239,68,68,0.5); }
  .member-modal-avatar {
    width: 95px; height: 95px; border-radius: 50%;
    background: linear-gradient(135deg, #2a2a4a, #1a1a2e);
    border: 3px solid #8b5cf6;
    display: flex; align-items: center; justify-content: center;
    font-size: 44px; margin: 0 auto 14px;
    overflow: hidden; background-size: cover; background-position: center;
    box-shadow: 0 0 35px rgba(139,92,246,0.6);
  }
  .member-modal-name { font-size: 20px; font-weight: 900; color: #fff; margin-bottom: 4px; }
  .member-modal-username { font-size: 12px; color: #94a3b8; font-family: monospace; margin-bottom: 14px; }
  .member-modal-badges { display: flex; gap: 6px; justify-content: center; margin-bottom: 20px; flex-wrap: wrap; }
  .member-badge { font-size: 11px; padding: 4px 12px; border-radius: 20px; font-weight: bold; }
  .badge-leader { background: rgba(244,197,66,0.2); color: #fde68a; border: 1px solid rgba(244,197,66,0.5); }
  .badge-admin { background: rgba(139,92,246,0.2); color: #c4b5fd; border: 1px solid rgba(139,92,246,0.5); }
  .badge-member { background: rgba(100,116,139,0.2); color: #cbd5e1; border: 1px solid rgba(100,116,139,0.5); }
  .badge-online { background: rgba(34,197,94,0.2); color: #4ade80; border: 1px solid rgba(34,197,94,0.5); }
  .badge-offline { background: rgba(100,116,139,0.2); color: #94a3b8; border: 1px solid rgba(100,116,139,0.4); }
  .badge-level { background: rgba(6,182,212,0.2); color: #67e8f9; border: 1px solid rgba(6,182,212,0.5); font-family: monospace; }
  .member-modal-actions { display: flex; gap: 8px; flex-direction: column; }
  .member-btn {
    padding: 13px; border-radius: 12px; border: none;
    font-family: inherit; font-weight: bold; font-size: 14px;
    cursor: pointer; text-decoration: none; text-align: center;
    transition: 0.2s;
    display: flex; align-items: center; justify-content: center; gap: 6px;
  }
  .member-btn:hover { transform: translateY(-1px); }
  .member-btn-chat { background: linear-gradient(135deg, #8b5cf6, #6b4eff); color: #fff; box-shadow: 0 4px 15px rgba(139,92,246,0.45); }
  .member-btn-profile { background: rgba(148,163,184,0.15); color: #fff; border: 1px solid rgba(148,163,184,0.25); }
  .info-emblem-big { font-size: 72px; margin-bottom: 12px; filter: drop-shadow(0 0 25px rgba(139,92,246,0.6)); }
  .info-name { font-size: 22px; font-weight: 900; color: #c4b5fd; margin-bottom: 6px; }
  .info-desc { font-size: 13px; color: #94a3b8; line-height: 1.7; margin-bottom: 16px; }
  .info-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 16px; }
  .info-stat { padding: 14px; background: rgba(15,23,42,0.6); border: 1px solid rgba(148,163,184,0.15); border-radius: 12px; text-align: center; }
  .info-stat .v { font-size: 20px; font-weight: 900; color: #fde68a; font-family: monospace; margin-bottom: 3px; }
  .info-stat .l { font-size: 11px; color: #94a3b8; }
  .toast {
    position: fixed; bottom: 100px; left: 50%; transform: translateX(-50%);
    background: rgba(34,197,94,0.95); color: #fff;
    padding: 12px 20px; border-radius: 12px; font-size: 13px;
    z-index: 9999; font-family: inherit; font-weight: bold;
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
  }
</style>
{% endblock %}
{% block content %}
  <div class="chat-header">
    <a href="{{ back_url }}" class="hdr-btn" title="بازگشت">→</a>
    <div class="hdr-emblem">{{ alliance.emblem }}</div>
    <div class="hdr-center" onclick="openInfoModal()">
      <div class="hdr-name">{{ alliance.name }}</div>
      <div class="hdr-meta">
        <span>👥 {{ member_count }} عضو</span>
        <span>·</span>
        <span>{{ online_count|default:0 }} آنلاین</span>
        <span>·</span>
        <span>{% if my_role == "leader" %}👑 رهبر{% elif my_role == "admin" %}🛡️ مدیر{% else %}👤 عضو{% endif %}</span>
      </div>
    </div>
    <div class="hdr-menu-wrap">
      <button class="hdr-btn" onclick="toggleMenu(event)" title="منو">⋮</button>
      <div class="hdr-menu" id="hdrMenu" onclick="event.stopPropagation()">
        <button class="hdr-menu-item" onclick="openInfoModal()">
          <span class="mi-icon">ℹ️</span>
          <span>اطلاعات اتحاد</span>
        </button>
        <button class="hdr-menu-item" onclick="copyAllianceName()">
          <span class="mi-icon">📋</span>
          <span>کپی اسم اتحاد</span>
        </button>
        {% if my_role == "leader" %}
          <div class="hdr-menu-sep"></div>
          <a href="/alliance/{{ alliance.id }}/edit/" class="hdr-menu-item">
            <span class="mi-icon">✏️</span>
            <span>ویرایش اتحاد</span>
          </a>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="members-strip" id="membersStrip">
    {% for m in members %}
      <button type="button" class="member-item"
        data-user-id="{{ m.user.id }}"
        data-alias="{{ m.user.alias }}"
        data-username="{{ m.user.username }}"
        data-avatar-emoji="{% if m.avatar.is_image %}🖼️{% else %}{{ m.avatar.value }}{% endif %}"
        data-avatar-url="{% if m.avatar.is_image %}{{ m.avatar.value }}{% endif %}"
        data-role="{{ m.role }}"
        data-online="{% if m.is_online %}1{% else %}0{% endif %}"
        data-level="{{ m.level }}"
        data-is-me="{% if m.is_me %}1{% else %}0{% endif %}"
        data-nickname="{{ m.nickname }}"
        data-display-name="{{ m.display_name }}"
        onclick="openMemberModal(this)">
        <div class="member-av {% if m.role == 'leader' %}leader{% elif m.role == 'admin' %}admin{% endif %}{% if m.is_me %} me{% endif %}"
             {% if m.avatar.is_image %}style="background-image: url('{{ m.avatar.value }}');"{% endif %}>
          {% if not m.avatar.is_image %}{{ m.avatar.value }}{% endif %}
          <div class="member-status {% if m.is_online %}online{% else %}offline{% endif %}"></div>
        </div>
        <div class="member-name">{{ m.display_name|truncatechars:8 }}</div>
      </button>
    {% endfor %}
  </div>

  <div class="messages-area" id="messagesArea">
    {% if chat_messages %}
      {% for m in chat_messages %}
        {% if m.message_type == "system" %}
          <div class="system-msg">{{ m.body }}</div>
        {% else %}
          <div class="msg-row {% if m.is_me %}me{% endif %}">
            <div class="msg-avatar"
                 {% if m.avatar.is_image %}style="background-image: url('{{ m.avatar.value }}');"{% endif %}>
              {% if not m.avatar.is_image %}{{ m.avatar.value }}{% endif %}
            </div>
            <div class="msg-content">
              {% if not m.is_me %}<div class="msg-sender">{{ m.sender_alias }}</div>{% endif %}
              <div class="msg-bubble">{{ m.body }}</div>
              <div class="msg-time">{{ m.sent_at|date:"H:i" }}</div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    {% else %}
      <div class="empty-chat">
        <span class="big-icon">💬</span>
        هنوز پیامی در این اتحاد نیست.<br>
        اولین پیام رو بفرست!
      </div>
    {% endif %}
  </div>

  {% if can_send %}
    <form method="post" class="chat-input-bar" id="chatForm">
      {% csrf_token %}
      <input type="text" name="body" placeholder="پیامت را بنویس..." maxlength="2000" required autocomplete="off" id="chatInput">
      <button type="submit" title="ارسال">↑</button>
    </form>
  {% else %}
    <div class="blocked-bar">🔒 {{ send_blocked_reason }}</div>
  {% endif %}

  <div class="member-modal-bg" id="memberModal" onclick="if(event.target.id==='memberModal')closeMemberModal()">
    <div class="member-modal">
      <button class="member-modal-close" onclick="closeMemberModal()" type="button">✕</button>
      <div class="member-modal-avatar" id="modalAvatar">👤</div>
      <div class="member-modal-name" id="modalName">—</div>
      <div class="member-modal-username" id="modalUsername">@—</div>
      <div class="member-modal-badges" id="modalBadges"></div>
      <div class="member-modal-actions" id="modalActions"></div>
    </div>
  </div>

  <div class="info-modal-bg" id="infoModal" onclick="if(event.target.id==='infoModal')closeInfoModal()">
    <div class="info-modal">
      <button class="member-modal-close" onclick="closeInfoModal()" type="button">✕</button>
      <div class="info-emblem-big">{{ alliance.emblem }}</div>
      <div class="info-name">{{ alliance.name }}</div>
      {% if alliance.description %}<div class="info-desc">{{ alliance.description }}</div>{% endif %}
      <div class="info-stats">
        <div class="info-stat"><div class="v">{{ member_count }}</div><div class="l">👥 اعضا</div></div>
        <div class="info-stat"><div class="v">{{ online_count|default:0 }}</div><div class="l">🟢 آنلاین</div></div>
        <div class="info-stat"><div class="v">{{ alliance.max_members }}</div><div class="l">📊 ظرفیت</div></div>
        <div class="info-stat"><div class="v">{% if my_role == "leader" %}👑{% elif my_role == "admin" %}🛡️{% else %}👤{% endif %}</div><div class="l">نقش شما</div></div>
      </div>
    </div>
  </div>
{% endblock %}
{% block extra_js %}
<script>
  const ALLIANCE_DATA = {
    id: {{ alliance.id }},
    myRole: "{{ my_role }}",
    name: "{{ alliance.name|escapejs }}",
  };
  const messagesArea = document.getElementById('messagesArea');
  if (messagesArea) setTimeout(() => { messagesArea.scrollTop = messagesArea.scrollHeight; }, 50);
  const chatInput = document.getElementById('chatInput');
  if (chatInput) setTimeout(() => chatInput.focus(), 200);

  function toggleMenu(e) { e.stopPropagation(); document.getElementById('hdrMenu').classList.toggle('active'); }
  document.addEventListener('click', () => document.getElementById('hdrMenu').classList.remove('active'));
  function openInfoModal() { document.getElementById('hdrMenu').classList.remove('active'); document.getElementById('infoModal').classList.add('active'); }
  function closeInfoModal() { document.getElementById('infoModal').classList.remove('active'); }
  function copyAllianceName() {
    document.getElementById('hdrMenu').classList.remove('active');
    const name = ALLIANCE_DATA.name;
    if (navigator.clipboard) navigator.clipboard.writeText(name).then(() => showToast('✓ اسم کپی شد: ' + name));
  }
  function showToast(msg) {
    const t = document.createElement('div');
    t.className = 'toast';
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => t.remove(), 2200);
  }
  function openMemberModal(btn) {
    const d = btn.dataset;
    const avEl = document.getElementById('modalAvatar');
    if (d.avatarUrl) { avEl.style.backgroundImage = `url('${d.avatarUrl}')`; avEl.textContent = ''; }
    else { avEl.style.backgroundImage = ''; avEl.textContent = d.avatarEmoji || '👤'; }
    document.getElementById('modalName').textContent = d.displayName || d.alias || '—';
    document.getElementById('modalUsername').textContent = '@' + (d.username || '—');
    let badges = '';
    if (d.role === 'leader') badges += '<span class="member-badge badge-leader">👑 رهبر</span>';
    else if (d.role === 'admin') badges += '<span class="member-badge badge-admin">🛡️ مدیر</span>';
    else badges += '<span class="member-badge badge-member">👤 عضو</span>';
    if (d.online === '1') badges += '<span class="member-badge badge-online">● آنلاین</span>';
    else badges += '<span class="member-badge badge-offline">● آفلاین</span>';
    if (d.level) badges += '<span class="member-badge badge-level">Lv ' + d.level + '</span>';
    document.getElementById('modalBadges').innerHTML = badges;
    let actions = '';
    if (d.isMe === '1') {
      actions = '<a href="/accounts/profile/" class="member-btn member-btn-profile">👤 پروفایل من</a>';
    } else {
      actions = `<a href="/social/chat/${d.userId}/" class="member-btn member-btn-chat">💬 ارسال پیام</a>`;
    }
    document.getElementById('modalActions').innerHTML = actions;
    document.getElementById('memberModal').classList.add('active');
  }
  function closeMemberModal() { document.getElementById('memberModal').classList.remove('active'); }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { closeMemberModal(); closeInfoModal(); document.getElementById('hdrMenu').classList.remove('active'); }
  });
</script>
{% endblock %}
