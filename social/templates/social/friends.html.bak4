{% extends "base.html" %}
{% block title %}دوستان{% endblock %}

{% block extra_css %}
<style>
  .page-head { margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; }
  .page-head h1 { font-size: 22px; font-weight: bold; }
  .page-head h1 span { color: var(--gold); }
  
  /* ===== کارت اتحاد ===== */
  .alliance-card {
    display: flex; align-items: center; gap: 14px;
    padding: 16px 18px;
    background: radial-gradient(circle at 100% 0%, rgba(139,92,246,0.25), transparent 60%),
                linear-gradient(135deg, #1a0f2e, #0f0f1e);
    border: 1.5px solid rgba(139,92,246,0.4);
    border-radius: 18px;
    text-decoration: none;
    color: #fff;
    margin-bottom: 16px;
    transition: all 0.22s;
    box-shadow: 0 8px 25px rgba(139,92,246,0.15);
  }
  .alliance-card:hover {
    transform: translateY(-3px);
    border-color: rgba(139,92,246,0.8);
    box-shadow: 0 15px 35px rgba(139,92,246,0.3);
  }
  .ac-icon {
    font-size: 32px;
    width: 54px; height: 54px;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(139,92,246,0.3), rgba(6,182,212,0.15));
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    border: 1px solid rgba(255,255,255,0.1);
  }
  .ac-body { flex: 1; }
  .ac-title { font-size: 16px; font-weight: bold; margin-bottom: 3px; color: #c4b5fd; }
  .ac-desc { font-size: 12px; color: var(--muted); }
  .ac-arrow { font-size: 20px; color: #c4b5fd; }

  .alliance-card.member {
    background: radial-gradient(circle at 100% 0%, rgba(34,197,94,0.3), transparent 60%),
                linear-gradient(135deg, #0a1f0f, #0f1e15);
    border-color: rgba(34,197,94,0.55);
    box-shadow: 0 8px 25px rgba(34,197,94,0.2);
  }
  .alliance-card.member:hover {
    border-color: rgba(34,197,94,0.9);
    box-shadow: 0 15px 35px rgba(34,197,94,0.4);
  }
  .alliance-card.member .ac-title { color: #86efac; }
  .alliance-card.member .ac-arrow { color: #86efac; }
  .alliance-card.member .ac-icon {
    background: linear-gradient(135deg, rgba(34,197,94,0.35), rgba(6,182,212,0.15));
    border-color: rgba(34,197,94,0.4);
  }
  .ac-tag {
    font-size: 10px;
    color: #1a1a1a;
    background: var(--gold);
    padding: 2px 8px;
    border-radius: 6px;
    margin-right: 6px;
    font-family: monospace;
    font-weight: bold;
    vertical-align: middle;
  }
  .ac-last {
    color: #86efac;
    font-size: 11px;
    margin-top: 3px;
    display: block;
    opacity: 0.9;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  .search-card { background: rgba(30,41,59,0.6); border: 1px solid var(--border); border-radius: 20px; padding: 18px; margin-bottom: 24px; }
  .search-form { display: flex; gap: 10px; }
  .search-form input { flex: 1; padding: 14px 18px; border-radius: 14px; border: 1.5px solid var(--border); background: rgba(15,23,42,0.8); color: #fff; font-size: 15px; font-family: inherit; }
  .search-form input:focus { outline: none; border-color: var(--teal); }
  .search-form button { background: linear-gradient(135deg, #06b6d4, #3b82f6); color: #fff; border: none; padding: 0 24px; border-radius: 14px; font-size: 15px; font-weight: bold; cursor: pointer; }

  .section-title { font-size: 16px; color: var(--text); margin-bottom: 14px; font-weight: bold; display: flex; align-items: center; gap: 8px; }
  .badge-count { background: var(--gold); color: #000; font-size: 12px; padding: 2px 8px; border-radius: 10px; font-weight: 900; }

  .user-card { display: flex; align-items: center; gap: 14px; background: rgba(30,41,59,0.7); border: 1px solid var(--border); border-radius: 18px; padding: 14px 18px; margin-bottom: 12px; }
  .avatar-wrapper { position: relative; flex-shrink: 0; }
  .user-av { width: 54px; height: 54px; border-radius: 50%; background: linear-gradient(135deg, rgba(244,197,66,0.2), rgba(139,92,246,0.2)); display: flex; align-items: center; justify-content: center; font-size: 28px; border: 2px solid var(--border); background-size: cover; background-position: center; }
  
  .online-dot { position: absolute; bottom: 2px; right: 2px; width: 14px; height: 14px; background: #22c55e; border-radius: 50%; border: 2px solid var(--card); box-shadow: 0 0 10px #22c55e; }
  .offline-dot { position: absolute; bottom: 2px; right: 2px; width: 14px; height: 14px; background: #64748b; border-radius: 50%; border: 2px solid var(--card); }
  
  .user-info { flex: 1; }
  .user-name { font-size: 16px; font-weight: bold; color: #fff; margin-bottom: 4px; display: flex; align-items: center; gap: 6px; }
  .user-id { font-size: 11px; color: var(--dim); font-family: monospace; }
  .level-tag { background: linear-gradient(135deg, #8b5cf6, #6b4eff); color: #fff; font-size: 10px; padding: 2px 6px; border-radius: 6px; font-family: monospace; }
  
  .actions { display: flex; gap: 8px; }
  .btn-action { padding: 10px 14px; border-radius: 12px; font-size: 13px; font-weight: bold; cursor: pointer; border: none; text-decoration: none; transition: 0.2s; }
  .btn-action:hover { transform: scale(1.05); }
  .btn-chat { background: linear-gradient(135deg, #3b82f6, #2563eb); color: #fff; }
  .btn-invite { background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; }
  .btn-accept { background: linear-gradient(135deg, #22c55e, #16a34a); color: #fff; }
  .btn-reject { background: rgba(239,68,68,0.15); color: #f87171; border: 1px solid rgba(239,68,68,0.3); }

  /* ===== مودال دعوت به بازی (تم فیروزه‌ای/بنفش) ===== */
  .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); backdrop-filter: blur(8px); z-index: 1000; justify-content: center; align-items: center; padding: 20px; }
  .modal-overlay.active { display: flex; animation: fadeIn 0.25s ease-out; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  
  .invite-modal { 
    background: linear-gradient(135deg, rgba(30,41,59,0.95), rgba(15,23,42,0.95));
    border: 1.5px solid rgba(139,92,246,0.4); 
    border-radius: 24px; width: 100%; max-width: 420px; padding: 24px; 
    position: relative; box-shadow: 0 20px 50px rgba(0,0,0,0.6), 0 0 40px rgba(139,92,246,0.15);
    animation: slideUp 0.3s ease-out;
  }
  @keyframes slideUp { from { transform: translateY(30px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
  
  .modal-close { position: absolute; top: 16px; right: 16px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.1); color: #fff; width: 34px; height: 34px; border-radius: 50%; cursor: pointer; font-size: 16px; transition: 0.2s; }
  .modal-close:hover { background: rgba(239,68,68,0.3); border-color: rgba(239,68,68,0.5); }
  
  .modal-title { font-size: 20px; font-weight: 900; text-align: center; margin-bottom: 4px; color: #fff; }
  .modal-sub { font-size: 12px; color: var(--muted); text-align: center; margin-bottom: 20px; }
  .modal-target { color: var(--teal); font-weight: bold; }

  .section-label { font-size: 13px; color: #c4b5fd; margin: 16px 0 10px; font-weight: bold; display: flex; align-items: center; gap: 6px; }
  
  /* دکمه‌های حالت حرف */
  .letter-modes { display: flex; gap: 8px; }
  .mode-btn { 
    flex: 1; padding: 10px; border-radius: 12px; 
    background: rgba(15,23,42,0.6); border: 1.5px solid var(--border);
    color: var(--muted); font-size: 13px; font-weight: bold; font-family: inherit;
    cursor: pointer; transition: 0.2s; display: flex; align-items: center; justify-content: center; gap: 6px;
  }
  .mode-btn:hover { border-color: rgba(139,92,246,0.5); }
  .mode-btn.active { 
    background: linear-gradient(135deg, rgba(139,92,246,0.2), rgba(6,182,212,0.1)); 
    border-color: var(--purple); color: #fff; box-shadow: 0 0 15px rgba(139,92,246,0.3);
  }
  
  .invite-input { 
    width: 100%; padding: 12px; border-radius: 12px; 
    border: 1.5px solid var(--border); background: rgba(15,23,42,0.8); 
    color: #fff; text-align: center; font-size: 18px; font-family: monospace;
    margin-top: 10px; transition: 0.3s; display: none;
  }
  .invite-input.show { display: block; animation: fadeIn 0.3s; }
  .invite-input:focus { outline: none; border-color: var(--teal); }

  /* گرید دسته‌ها */
  .cats-grid { 
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; 
    max-height: 150px; overflow-y: auto; padding-right: 4px; 
  }
  .cats-grid::-webkit-scrollbar { width: 4px; }
  .cats-grid::-webkit-scrollbar-thumb { background: rgba(139,92,246,0.4); border-radius: 4px; }
  
  .cat-opt { 
    background: rgba(15,23,42,0.6); border: 1px solid var(--border); 
    padding: 8px 4px; border-radius: 8px; font-size: 12px; 
    text-align: center; cursor: pointer; transition: 0.2s; color: var(--muted);
    user-select: none;
  }
  .cat-opt.active { 
    background: rgba(6,182,212,0.2); border-color: var(--teal); 
    color: #fff; font-weight: bold; box-shadow: 0 0 10px rgba(6,182,212,0.2);
  }

  .btn-send { 
    width: 100%; padding: 16px; margin-top: 20px; border: none; border-radius: 14px; 
    font-size: 16px; font-weight: bold; font-family: inherit; cursor: pointer; 
    background: linear-gradient(135deg, #8b5cf6, #06b6d4); color: #fff; 
    box-shadow: 0 8px 25px rgba(139,92,246,0.4); transition: 0.2s;
  }
  .btn-send:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(139,92,246,0.6); }
  .btn-send.offline { background: #475569; box-shadow: none; }
  .btn-send.offline:hover { transform: none; }
</style>


  /* ===== مودال لیست اتحادها ===== */
  .alliance-modal {
    background: linear-gradient(135deg, rgba(30,41,59,0.98), rgba(15,23,42,0.98));
    border: 1.5px solid rgba(139,92,246,0.4);
    border-radius: 22px;
    width: 100%;
    max-width: 460px;
    max-height: 85vh;
    overflow-y: auto;
    padding: 26px 22px;
    position: relative;
    box-shadow: 0 25px 60px rgba(0,0,0,0.7);
  }
  .alliance-modal h2 { font-size: 20px; color: #c4b5fd; text-align: center; margin-bottom: 6px; }
  .alliance-modal .modal-sub { font-size: 12px; color: var(--muted); text-align: center; margin-bottom: 18px; }
  .create-alliance-btn {
    display: block; padding: 12px; border-radius: 12px;
    background: linear-gradient(135deg, #22c55e, #16a34a);
    color: #fff; text-decoration: none; text-align: center;
    font-weight: bold; font-size: 14px; margin-bottom: 16px;
    box-shadow: 0 8px 20px rgba(34,197,94,0.3);
  }
  .alliance-item {
    display: flex; align-items: center; gap: 12px;
    padding: 12px; border-radius: 14px; margin-bottom: 8px;
    background: rgba(15,23,42,0.6); border: 1px solid var(--border);
  }
  .alliance-item .emblem {
    font-size: 26px; width: 46px; height: 46px; border-radius: 12px;
    background: linear-gradient(135deg, rgba(139,92,246,0.25), rgba(6,182,212,0.15));
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .alliance-item .info { flex: 1; min-width: 0; }
  .alliance-item .name { font-size: 14px; font-weight: bold; color: #fff; margin-bottom: 3px; display: flex; align-items: center; gap: 6px; }
  .alliance-item .tag { background: var(--gold); color: #1a1a1a; font-size: 9px; padding: 1px 6px; border-radius: 5px; font-family: monospace; font-weight: bold; }
  .alliance-item .meta { font-size: 11px; color: var(--muted); }
  .alliance-item .join-btn {
    padding: 8px 14px; background: linear-gradient(135deg, #8b5cf6, #6b4eff);
    color: #fff; border: none; border-radius: 10px; font-family: inherit;
    font-weight: bold; font-size: 12px; cursor: pointer;
    box-shadow: 0 4px 12px rgba(139,92,246,0.3); flex-shrink: 0;
  }
  .empty-alliances { text-align: center; padding: 30px 10px; color: var(--muted); font-size: 13px; }
  .alliance-password-modal {
    background: linear-gradient(135deg, rgba(30,41,59,0.98), rgba(15,23,42,0.98));
    border: 1.5px solid rgba(139,92,246,0.4);
    border-radius: 20px; padding: 24px; max-width: 360px; width: 100%; position: relative;
  }
  .alliance-password-modal h3 { font-size: 18px; color: #c4b5fd; text-align: center; margin-bottom: 8px; }{% endblock %}

{% block content %}
  <!-- کارت اتحاد -->
  {% if my_alliance %}
    <a href="/alliance/" class="alliance-card member">
      <div class="ac-icon">{{ my_alliance.emblem }}</div>
      <div class="ac-body">
        <div class="ac-title">
          {{ my_alliance.name }}
          {% if my_alliance.tag %}<span class="ac-tag">{{ my_alliance.tag }}</span>{% endif %}
        </div>
        <div class="ac-desc">
          {{ my_alliance.member_count }} / {{ my_alliance.max_members }} عضو · {{ my_alliance.role_display }}
          {% if my_alliance.last_message %}
            <span class="ac-last">💬 {{ my_alliance.last_message_sender }}: {{ my_alliance.last_message|truncatechars:40 }}</span>
          {% else %}
            <span class="ac-last" style="color:#64748b;">💬 هنوز پیامی نیست</span>
          {% endif %}
        </div>
      </div>
      <div class="ac-arrow">←</div>
    </a>
  {% else %}
    <button type="button" onclick="openAllianceModal()" class="alliance-card" style="width:100%; border:none; cursor:pointer; font-family:inherit; text-align:inherit; font-size:inherit;">
      <div class="ac-icon">🛡️</div>
      <div class="ac-body">
        <div class="ac-title">اتحاد</div>
        <div class="ac-desc">لیست اتحادها رو ببین یا خودت بساز</div>
      </div>
      <div class="ac-arrow">←</div>
    </button>
  {% endif %}

  <!-- بنر دعوت‌های دریافتی -->
  {% for inv in pending_invites %}
    <div class="user-card" style="border-color: #f59e0b; background: rgba(245, 158, 11, 0.1);">
      <div class="user-av">{{ inv.from_user.alias|slice:":1" }}</div>
      <div class="user-info">
        <div class="user-name">{{ inv.from_user.alias }} شما را به بازی دعوت کرد!</div>
        <div class="user-id">منتظر پاسخ شما...</div>
      </div>
      <div class="actions">
        <button onclick="acceptInvite({{ inv.id }})" class="btn-action btn-accept">قبول</button>
        <button onclick="rejectInvite({{ inv.id }})" class="btn-action btn-reject">رد</button>
      </div>
    </div>
  {% endfor %}

  <div class="search-card">
    <form method="get" action="/social/search/" class="search-form">
      <input type="text" name="q" placeholder="جستجوی نام نمایشی یا نام کاربری...">
      <button type="submit">🔍</button>
    </form>
  </div>

  {% if incoming %}
    <div class="section-title">📬 درخواست‌های دوستی <span class="badge-count">{{ incoming|length }}</span></div>
    {% for item in incoming %}
      <div class="user-card">
        <div class="user-av">{{ item.avatar }}</div>
        <div class="user-info">
          <div class="user-name">{{ item.from.alias }}</div>
          <div class="user-id">@{{ item.from.username }}</div>
        </div>
        <div class="actions">
          <form method="post" action="/social/accept/{{ item.req.id }}/">
            {% csrf_token %}
            <button type="submit" class="btn-action btn-accept">✓</button>
          </form>
          <form method="post" action="/social/reject/{{ item.req.id }}/">
            {% csrf_token %}
            <button type="submit" class="btn-action btn-reject">✕</button>
          </form>
        </div>
      </div>
    {% endfor %}
  {% endif %}

  <div class="section-title">👫 دوستان من <span class="badge-count">{{ friends|length }}</span></div>
  
  {% if friends %}
    {% for f in friends %}
      <div class="user-card">
        <div class="avatar-wrapper">
          <div class="user-av">{{ f.avatar }}</div>
          {% if f.is_online %}<div class="online-dot"></div>{% else %}<div class="offline-dot"></div>{% endif %}
        </div>
        <div class="user-info">
          <div class="user-name">{{ f.user.alias }} <span class="level-tag">Lv {{ f.level }}</span></div>
          <div class="user-id">@{{ f.user.username }}</div>
        </div>
        <div class="actions">
          <button onclick="openInviteModal({{ f.user.id }}, '{{ f.user.alias }}', {{ f.is_online|yesno:'true,false' }})" class="btn-action btn-invite">🎮</button>
          <a href="/social/chat/{{ f.user.id }}/" class="btn-action btn-chat">💬</a>
        </div>
      </div>
    {% endfor %}
  {% else %}
    <div style="text-align:center; padding:20px; color:var(--muted);">هنوز دوستی نداری.</div>
  {% endif %}

  <!-- ===== مودال پیشرفته دعوت ===== -->
  <div class="modal-overlay" id="inviteModal">
    <div class="invite-modal">
      <button class="modal-close" onclick="closeInviteModal()">✕</button>
      
      <div class="modal-title">🎮 دعوت به بازی</div>
      <div class="modal-sub">ارسال به <span class="modal-target" id="targetName"></span></div>
      
      <div class="section-label">🔤 حالت انتخاب حرف</div>
      <div class="letter-modes">
        <button type="button" class="mode-btn active" id="btnModeRandom" onclick="setLetterMode('random')">🎲 تصادفی</button>
        <button type="button" class="mode-btn" id="btnModeManual" onclick="setLetterMode('manual')">✍️ دستی</button>
      </div>
      <input type="text" id="inviteLetter" class="invite-input" placeholder="حرف دلخواه (مثلاً ب)" maxlength="2">

      <div class="section-label">📋 دسته‌ها <span style="font-size:10px; color:var(--dim); font-weight:normal;">(برای حذف کلیک کن)</span></div>
      <div class="cats-grid" id="inviteCats">
        <!-- دسته‌ها با جاوااسکریپت پر میشن -->
      </div>

      <button class="btn-send" onclick="sendInviteRequest()" id="btnSendInvite">ارسال درخواست بازی</button>
    </div>
  </div>


  {% if not my_alliance %}
  <!-- مودال لیست اتحادها -->
  <div class="modal-overlay" id="allianceModal">
    <div class="alliance-modal">
      <button type="button" class="modal-close" onclick="closeAllianceModal()">✕</button>
      <h2>🛡️ لیست اتحادها</h2>
      <p class="modal-sub">یکی رو انتخاب کن یا خودت بساز</p>

      <a href="/alliance/create/" class="create-alliance-btn">+ ساخت اتحاد جدید</a>

      <div class="alliance-list">
        {% for a in all_alliances %}
        <div class="alliance-item">
          <div class="emblem">{{ a.emblem }}</div>
          <div class="info">
            <div class="name">
              {{ a.name }}
              {% if a.tag %}<span class="tag">{{ a.tag }}</span>{% endif %}
              {% if a.has_password %}<span style="font-size:12px;">🔒</span>{% endif %}
            </div>
            <div class="meta">{{ a.leader_avatar }} · {{ a.member_count }} / {{ a.max_members }} عضو</div>
          </div>
          {% if a.has_password %}
            <button type="button" class="join-btn" onclick="openPasswordModal({{ a.id }})">🔐 ورود</button>
          {% else %}
            <form method="post" action="/alliance/join-id/{{ a.id }}/" style="display:inline;">
              {% csrf_token %}
              <button type="submit" class="join-btn">ورود</button>
            </form>
          {% endif %}
        </div>
        {% empty %}
        <div class="empty-alliances">هنوز اتحادی ساخته نشده. اولین نفر باش!</div>
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- مودال رمز اتحاد -->
  <div class="modal-overlay" id="alliancePasswordModal">
    <div class="alliance-password-modal">
      <h3>🔐 رمز اتحاد</h3>
      <p style="color: var(--muted); font-size: 12px; margin-bottom: 14px;">این اتحاد رمز دارد. رمز را وارد کن.</p>
      <form method="post" id="alliancePasswordForm">
        {% csrf_token %}
        <input type="password" name="password" placeholder="رمز اتحاد" required autofocus
               style="width:100%; padding:12px; border-radius:10px; border:1.5px solid var(--border); background:var(--bg); color:#fff; font-family:inherit; margin-bottom:12px; box-sizing:border-box;">
        <div style="display:flex; gap:8px;">
          <button type="submit" class="join-btn" style="flex:1; padding:12px;">ورود</button>
          <button type="button" onclick="closePasswordModal()" style="flex:1; padding:12px; background:rgba(148,163,184,0.2); color:#fff; border:none; border-radius:10px; font-family:inherit; cursor:pointer; font-weight:bold;">انصراف</button>
        </div>
      </form>
    </div>
  </div>
  {% endif %}
{% endblock %}

{% block extra_js %}
<script>
// لیست کامل دسته‌ها
const ALL_CATS = [
    "اسم", "فامیل", "میوه", "رنگ", "شهر", "کشور", "ماشین", "حیوان", "اشیا", "غذا",
    "شغل", "اعضای بدن", "نام گل", "فیلم", "خواننده", "برند", "ورزش", "ابزار", "لباس", 
    "شخصیت کارتونی", "کتاب", "مکان", "گیاه", "مزه", "صدا", "پارچه", "بیماری", 
    "زبان", "عدد", "کلمه انگلیسی"
];

let currentTargetId = null;
let pollInterval = null;
let currentLetterMode = 'random';

// ساخت دسته‌ها هنگام لود صفحه
const catsContainer = document.getElementById('inviteCats');
ALL_CATS.forEach(cat => {
    const el = document.createElement('div');
    el.className = 'cat-opt active';
    el.innerText = cat;
    el.onclick = () => {
        el.classList.toggle('active');
        if (typeof window.soundClick === 'function') window.soundClick();
    };
    catsContainer.appendChild(el);
});

function openInviteModal(userId, name, isOnline) {
  currentTargetId = userId;
  document.getElementById('targetName').innerText = name;
  document.getElementById('inviteModal').classList.add('active');
  
  const btn = document.getElementById('btnSendInvite');
  if (!isOnline) {
    btn.innerText = 'دوستت آفلاینه! پیام در صف می‌مونه';
    btn.classList.add('offline');
  } else {
    btn.innerText = 'ارسال درخواست بازی';
    btn.classList.remove('offline');
  }
}

function closeInviteModal() {
  document.getElementById('inviteModal').classList.remove('active');
  if (pollInterval) clearInterval(pollInterval);
}

function setLetterMode(mode) {
  currentLetterMode = mode;
  document.getElementById('btnModeRandom').classList.remove('active');
  document.getElementById('btnModeManual').classList.remove('active');
  
  if (mode === 'random') {
    document.getElementById('btnModeRandom').classList.add('active');
    document.getElementById('inviteLetter').classList.remove('show');
  } else {
    document.getElementById('btnModeManual').classList.add('active');
    document.getElementById('inviteLetter').classList.add('show');
    document.getElementById('inviteLetter').focus();
  }
  if (typeof window.soundClick === 'function') window.soundClick();
}

function sendInviteRequest() {
  const letter = document.getElementById('inviteLetter').value.trim();
  const selectedCats = Array.from(document.querySelectorAll('#inviteCats .cat-opt.active')).map(el => el.innerText);
  
  if (selectedCats.length === 0) {
    alert('حداقل یک دسته را انتخاب کنید!');
    return;
  }

  const formData = new FormData();
  formData.append('letter_mode', currentLetterMode);
  formData.append('letter', currentLetterMode === 'manual' ? letter : '');
  selectedCats.forEach(c => formData.append('categories', c));
  formData.append('csrfmiddlewaretoken', '{{ csrf_token }}');

  const btn = document.getElementById('btnSendInvite');
  const originalText = btn.innerText;
  btn.innerText = 'در حال ارسال...';

  fetch(`/social/invite/${currentTargetId}/`, {
    method: 'POST',
    body: formData
  }).then(r => r.json()).then(data => {
    if (data.status === 'ok') {
      if (data.is_online) {
        btn.innerText = '⏳ منتظر قبول کردن...';
        pollInterval = setInterval(() => {
          fetch(`/social/invite/status/${data.invite_id}/`).then(r=>r.json()).then(st => {
            if (st.status === 'accepted') {
              clearInterval(pollInterval);
              window.location.href = st.url;
            } else if (st.status === 'rejected') {
              alert('دعوت رد شد.');
              closeInviteModal();
            }
          });
        }, 2000);
      } else {
        alert('دوستت آفلاین است. به محض ورود، درخواستت را می‌بیند.');
        closeInviteModal();
      }
    } else {
      alert('خطا در ارسال درخواست');
      btn.innerText = originalText;
    }
  }).catch(() => {
    alert('خطا در ارتباط با سرور');
    btn.innerText = originalText;
  });
}

function acceptInvite(inviteId) {
  fetch(`/social/invite/accept/${inviteId}/`, { method: 'POST', headers: { 'X-CSRFToken': '{{ csrf_token }}' } })
  .then(r=>r.json()).then(data => {
    if(data.status === 'ok') window.location.href = data.url;
  });
}

function rejectInvite(inviteId) {
  fetch(`/social/invite/reject/${inviteId}/`, { method: 'POST', headers: { 'X-CSRFToken': '{{ csrf_token }}' } })
  .then(() => window.location.reload());
}
</script>


<script>
function openAllianceModal() {
  var m = document.getElementById('allianceModal');
  if (m) { m.classList.add('active'); document.body.style.overflow = 'hidden'; }
  if (window.soundClick) window.soundClick();
}
function closeAllianceModal() {
  var m = document.getElementById('allianceModal');
  if (m) { m.classList.remove('active'); document.body.style.overflow = ''; }
}
function openPasswordModal(allianceId) {
  var form = document.getElementById('alliancePasswordForm');
  if (form) { form.action = '/alliance/join-id/' + allianceId + '/'; }
  var m = document.getElementById('alliancePasswordModal');
  if (m) {
    m.classList.add('active');
    setTimeout(function() { var inp = form.querySelector('input[name="password"]'); if (inp) inp.focus(); }, 100);
  }
}
function closePasswordModal() {
  var m = document.getElementById('alliancePasswordModal');
  if (m) m.classList.remove('active');
}
(function() {
  var am = document.getElementById('allianceModal');
  if (am) am.addEventListener('click', function(e) { if (e.target.id === 'allianceModal') closeAllianceModal(); });
  var pm = document.getElementById('alliancePasswordModal');
  if (pm) pm.addEventListener('click', function(e) { if (e.target.id === 'alliancePasswordModal') closePasswordModal(); });
})();
</script>
{% endblock %}
