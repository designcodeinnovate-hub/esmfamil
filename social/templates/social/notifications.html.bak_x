{% extends "base.html" %}
{% block title %}اعلان‌ها{% endblock %}

{% block extra_css %}
<style>
  .page-head {
    display: flex; align-items: center; gap: 12px;
    margin-bottom: 18px;
  }
  .page-head a {
    width: 42px; height: 42px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    color: var(--gold); text-decoration: none; font-size: 20px;
  }
  .page-head h1 { font-size: 22px; font-weight: bold; }
  .page-head h1 span { color: var(--gold); }

  .notif-card {
    display: flex; align-items: flex-start; gap: 14px;
    padding: 16px; margin-bottom: 10px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    text-decoration: none; color: var(--text);
    transition: all 0.15s;
  }
  .notif-card:hover {
    border-color: var(--gold);
    transform: translateX(-3px);
  }
  .notif-card.unread {
    border-color: rgba(244,197,66,0.4);
    background: linear-gradient(135deg, rgba(244,197,66,0.08), rgba(139,92,246,0.05));
  }
  .notif-icon {
    width: 46px; height: 46px;
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 24px; flex-shrink: 0;
    background: linear-gradient(135deg, rgba(244,197,66,0.2), rgba(139,92,246,0.15));
  }
  .notif-body { flex: 1; min-width: 0; }
  .notif-title { font-size: 14px; font-weight: bold; margin-bottom: 4px; }
  .notif-desc { font-size: 12px; color: var(--muted); line-height: 1.6; }
  .notif-time { font-size: 10px; color: var(--dim); margin-top: 6px; }
  .unread-dot {
    width: 10px; height: 10px;
    background: var(--gold);
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 8px;
    box-shadow: 0 0 8px rgba(244,197,66,0.7);
  }
  .empty {
    text-align: center; padding: 60px 20px;
    color: var(--muted); font-size: 14px;
  }
  .empty .icon { font-size: 60px; display: block; margin-bottom: 12px; opacity: 0.5; }
</style>
{% endblock %}

{% block content %}

  <div class="page-head">
    <a href="/game/">←</a>
    <h1>🔔 <span>اعلان‌ها</span></h1>
  </div>

  {% if notifications %}
    {% for n in notifications %}
      {% if n.url %}
        <a href="{{ n.url }}" class="notif-card {% if not n.is_read %}unread{% endif %}">
      {% else %}
        <div class="notif-card {% if not n.is_read %}unread{% endif %}">
      {% endif %}
        <div class="notif-icon">
          {% if n.type == "friend_request" %}👋
          {% elif n.type == "friend_accepted" %}✅
          {% elif n.type == "message" %}💬
          {% elif n.type == "game_invite" %}🎮
          {% elif n.type == "game_result" %}🏆
          {% elif n.type == "alliance_invite" %}🛡️
          {% elif n.type == "admin_broadcast" %}📢
          {% else %}🔔{% endif %}
        </div>
        <div class="notif-body">
          <div class="notif-title">{{ n.title }}</div>
          {% if n.body %}<div class="notif-desc">{{ n.body }}</div>{% endif %}
          <div class="notif-time">{{ n.created_at|date:"Y/m/d H:i" }}</div>
        </div>
        {% if not n.is_read %}<div class="unread-dot"></div>{% endif %}
      {% if n.url %}</a>{% else %}</div>{% endif %}
    {% endfor %}
  {% else %}
    <div class="empty">
      <span class="icon">📭</span>
      هنوز اعلانی نداری.
    </div>
  {% endif %}

{% endblock %}
