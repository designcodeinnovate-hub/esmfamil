from django.urls import path
from . import views

app_name = "game"

urlpatterns = [
    path("", views.home, name="home"),
    path("rooms/", views.rooms_list, name="rooms"),
    path("rooms/manage/", views.rooms_manage, name="rooms_manage"),
    path("rooms/join/<str:room_code>/", views.join_room, name="join_room"),
    path("rooms/leave/<str:room_code>/", views.leave_room, name="leave_room"),
    path("room/<str:room_code>/", views.room, name="room"),
    path("friends/", views.friends_page, name="friends"),
    path("leaderboard/", views.leaderboard_view, name="leaderboard"),
    path("top-players/", views.top_players_view, name="top_players"),
    path("quick/", views.quick_play, name="quick_play"),
    path("challenge/", views.challenge_home, name="challenge"),
    path("challenge/<int:tournament_id>/join/", views.tournament_join, name="tournament_join"),
    path("quick/bot/", views.bot_setup, name="bot_setup"),
    path("quick/bot/play/<uuid:game_id>/", views.bot_play, name="bot_play"),
    path("quick/bot/submit/<uuid:game_id>/", views.bot_submit, name="bot_submit"),
    path("match/", views.match_start, name="match_start"),
    path("match/wait/", views.match_wait, name="match_wait"),
    path("match/cancel/", views.match_cancel, name="match_cancel"),
    path("match/status/", views.match_status, name="match_status"),
    path("team/start/", views.team_start, name="team_start"),
    path("team/wait/", views.team_wait, name="team_wait"),
    path("team/cancel/", views.team_cancel, name="team_cancel"),
    path("team/status/", views.team_status, name="team_status"),
    path("team/select/<str:room_code>/", views.team_select, name="team_select"),
    path("team/play/<str:room_code>/", views.team_play, name="team_play"),
    path("team/play-status/<str:room_code>/", views.team_status_ajax, name="team_status_ajax"),
    path("team/round-end/<str:room_code>/", views.team_round_end, name="team_round_end"),
    path("team/result/<str:room_code>/", views.team_result, name="team_result"),
]
