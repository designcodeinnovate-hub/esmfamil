cat > dump.js << 'EOF'
const fs = require('fs');
const path = require('path');

const IGNORE = ['node_modules', '.git', 'dist', 'build', 'vendor', '.next', 'coverage', '.cache', 'venv', '__pycache__', 'migrations'];
const EXT = ['.js','.jsx','.ts','.tsx','.py','.html','.css','.json','.php','.java','.c','.cpp','.cs','.go','.rs','.rb','.md','.txt','.yml','.yaml','.env','.sql','.sh'];

let out = '';
function walk(dir) {
  for (const f of fs.readdirSync(dir)) {
    const full = path.join(dir, f);
    if (IGNORE.includes(f)) continue;
    const stat = fs.statSync(full);
    if (stat.isDirectory()) walk(full);
    else if (EXT.includes(path.extname(f))) {
      out += `\n\n===== FILE: ${full} =====\n`;
      out += fs.readFileSync(full, 'utf8');
    }
  }
}
walk('.');
fs.writeFileSync('PROJECT_DUMP.txt', out, 'utf8');
console.log('✅ ساخته شد: PROJECT_DUMP.txt');
EOF
node dump.js

